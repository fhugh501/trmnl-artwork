<div style="
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
">
  <img
    src="https://raw.githubusercontent.com/fhugh501/trmnl-artwork/main/artwork/esp32/esp32-electronics-trmnl-8bit.png"
    style="
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      object-fit: cover;
      object-position: center;
    "
  >
</div>